{
	"version": "3.0",
	"label": "app.name",
	"classes": ["chat"],
	"paths": ["chat"],
	"services": ["chat"],

	"architecture": {"engine": "starlark", "version": 4},
	"execute": ["lib/attachments.star", "lib/content.star", "chat.star"],
	"require": {"version": {"minimum": "2.0.12"}},

	"database": {
		"schema": 15,
		"file": "chat.db",
		"create": {"function": "database_create"},
		"upgrade": {"function": "database_upgrade"},
	},

	"functions": {
		// Direct messages to the user's hosted fediverse accounts, and the
		// accounts a contact's messaging address can be reached through
		// (the federation plan, phase 22); what the sessions of the user's
		// linked XMPP, Matrix and Mastodon accounts hear (phase 23).
		"activitypub/receive": {"function": "function_activitypub_receive"},
		"linked/receive": {"function": "function_linked_receive"},
		// Whether a stranger may write to a hosted account, asked by core's
		// XMPP engine under the acceptance rule (phase 25).
		"linked/accept": {"function": "function_linked_accept", "permission": "friends/read"},
		// A page of a hosted XMPP account's archive, which core's engine
		// answers its clients' archive queries from (phase 26).
		"linked/archive": {"function": "function_linked_archive"},
		"reachable": {"function": "function_reachable"},
		// What the people from Matrix do in a room this server relays for a
		// group, and the people on Matrix a search finds, for people (phase 24).
		"bridge/receive": {"function": "function_bridge_receive"},
		"directory": {"function": "function_directory"}
	},

	"icons": [
		{"action": "", "label": "app.name", "file": "images/icon.svg"}
	],

	"actions": {
		"": {"file": "web/dist/index.html"},
		"assets": {"files": "web/dist/assets"},
		"-/create": {"function": "action_create"},
		"images": {"files": "web/dist/images"},
		"-/list": {"function": "action_list"},
		"-/new": {"function": "action_new"},
		"-/person/:person/asset/:asset": {"function": "action_person_asset", "asset": true},
		"-/person/search": {"function": "action_person_search"},
		"-/preferences/get": {"function": "action_preferences_get"},
		"-/preferences/set": {"function": "action_preferences_set"},
		"-/encryption/verifications": {"function": "action_encryption_verifications"},
		"-/encryption/act": {"function": "action_encryption_act"},

		":chat": {"file": "web/dist/index.html"},
		":chat/-/view": {"function": "action_view"},
		":chat/-/resync": {"function": "action_resync"},
		":chat/-/messages": {"function": "action_messages"},
		":chat/-/messages/delete": {"function": "action_messages_delete"},
		":chat/-/messages/edit": {"function": "action_message_edit"},
		":chat/-/messages/forward": {"function": "action_messages_forward"},
		":chat/-/messages/forward/friend": {"function": "action_messages_forward_friend"},
		":chat/-/search": {"function": "action_search"},
		":chat/-/read": {"function": "action_mark_read"},
		":chat/-/react": {"function": "action_react"},
		":chat/-/send": {"function": "action_send"},
		":chat/-/typing": {"function": "action_typing"},
		":chat/-/presence": {"function": "action_presence"},
		":chat/-/members": {"function": "action_members"},
		":chat/-/rename": {"function": "action_rename"},
		":chat/-/leave": {"function": "action_leave"},
		":chat/-/accept": {"function": "action_accept"},
		":chat/-/decline": {"function": "action_decline"},
		":chat/-/delete": {"function": "action_delete"},
		":chat/-/member/add": {"function": "action_member_add"},
		":chat/-/member/remove": {"function": "action_member_remove"},
		":chat/-/encryption": {"function": "action_encryption"},
		":chat/-/encryption/devices": {"function": "action_encryption_devices"},
		":chat/-/encryption/trust": {"function": "action_encryption_trust"},
		":chat/-/encryption/verify": {"function": "action_encryption_verify"},
		":chat/-/encryption/setup": {"function": "action_encryption_setup"},
		":chat/-/encryption/recover": {"function": "action_encryption_recover"},
		":chat/-/attachments/:id": {"function": "action_attachment", "asset": true},
		":chat/-/attachments/:id/thumbnail": {"function": "action_attachment_thumbnail", "asset": true},
		":chat/-/attachments/:id/preview": {"function": "action_attachment_preview", "asset": true},
		":chat/-/:message/asset/:asset": {"function": "action_message_asset", "asset": true},
		":chat/settings": {"file": "web/dist/index.html"},
		":chat/settings/assets": {"files": "web/dist/assets"},
		":chat/settings/images": {"files": "web/dist/images"},
		":chat/assets": {"files": "web/dist/assets"},
		":chat/images": {"files": "web/dist/images"}
	},

	"errors": {

		"message/timeout": {"function": "error_message_timeout"}

	},

	"events": {
		"accept/query": {"function": "event_accept_query"},
		"attachment/fetch": {"function": "event_attachment_fetch"},
		"message": {"function": "event_message"},
		"message/delete": {"function": "event_message_delete"},
		"message/edit": {"function": "event_message_edit"},
		"message/react": {"function": "event_message_react"},
		"presence": {"function": "event_presence"},
		"receipt": {"function": "event_receipt"},
		"typing": {"function": "event_typing"},
		"new": {"function": "event_new"},
		"info": {"function": "event_info"},
		"rename": {"function": "event_rename"},
		"leave": {"function": "event_leave"},
		"member/add": {"function": "event_member_add"},
		"member/remove": {"function": "event_member_remove"},
		"removed": {"function": "event_removed"},
		"bridge/message": {"function": "event_bridge_message"},
		"bridge/edit": {"function": "event_bridge_edit"},
		"bridge/delete": {"function": "event_bridge_delete"},
		"bridge/react": {"function": "event_bridge_react"},
		"bridge/new": {"function": "event_bridge_new"},
		"bridge/accept": {"function": "event_bridge_accept"}
	}
}
