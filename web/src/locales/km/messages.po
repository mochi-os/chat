#: src/features/chats/components/new-chat.tsx:156
msgid "You already have a chat with this friend"
msgstr "អ្នកមានជជែកជាមួយមិត្តភក្តិនេះរួចហើយ"

#: src/features/chats/components/new-chat.tsx:316
msgid "You already have chats with:"
msgstr "អ្នកមានជជែកជាមួយ៖"

#: src/features/chats/index.tsx:956
msgid "You can attach at most {CAPTIONS_MAX} files to a message"
msgstr "អ្នកអាចភ្ជាប់ឯកសារយ៉ាងច្រើន {CAPTIONS_MAX} ទៅសារមួយ"

#: src/features/chats/index.tsx:952
msgid "You can mention at most {MENTIONS_MAX} people in a message"
msgstr "អ្នកអាចនិយាយអំពីមនុស្សយ៉ាងច្រើន {MENTIONS_MAX} នាក់ក្នុងសារមួយ"

#: src/features/chats/index.tsx:661
msgid "You can only delete your own messages"
msgstr "អ្នកអាចលុបបានតែសាររបស់អ្នកប៉ុណ្ណោះ"

#: ../../../lib/web/src/features/errors/general-error.tsx:61
msgid "You do not have access to this section."
msgstr "អ្នកមិនមានសិទ្ធិចូលប្រើផ្នែកនេះទេ។"

#: ../../../lib/web/src/features/errors/forbidden.tsx:18
msgid "You don't have necessary permission <0/>to view this resource."
msgstr "អ្នកមិនមានការអនុញ្ញាតចាំបាច់ <0/>ដើម្បីមើលធនធាននេះទេ។"

#: src/features/chats/index.tsx:1281
msgid "You left this chat"
msgstr "អ្នកបានចាកចេញពីការជជែកនេះ"

#: ../../../lib/web/src/lib/show-submitted-data.tsx:9
msgid "You submitted the following values:"
msgstr "អ្នកបានដាក់ស្នើតម្លៃខាងក្រោម៖"

#: src/features/chats/index.tsx:1280
msgid "You were removed from this chat"
msgstr "អ្នកត្រូវបានដកចេញពីការជជែកនេះ"

#: ../../../lib/web/src/components/notifications-dropdown.tsx:193
msgid "You're all caught up!"
msgstr "អ្នកបានមើលទាំងអស់ហើយ!"

#: ../../../lib/web/src/components/restore-banner.tsx:106
msgid "Your account was moved here from {source}. Until you delete it there, messages and notifications may reach both servers, some of your content keeps being served from the old server, and followers may take a few minutes to find you here."
msgstr "គណនីរបស់អ្នកត្រូវបានផ្លាស់ប្តូរមកទីនេះពី {source}។ រហូតដល់អ្នកលុបវានៅទីនោះ សារ និងការជូនដំណឹងអាចទៅដល់ម៉ាស៊ីនមេទាំងពីរ មាតិកាមួយចំនួនរបស់អ្នកនៅតែត្រូវបានបម្រើពីម៉ាស៊ីនមេចាស់ ហើយអ្នកតាមដានអាចចំណាយពេលប៉ុន្មាននាទីដើម្បីរកអ្នកនៅទីនេះ។"

#: ../../../lib/web/src/components/comment-composer.tsx:291
msgid "Your attachments will be lost."
msgstr "ឯកសារភ្ជាប់របស់អ្នកនឹងបាត់បង់។"

#: ../../../lib/web/src/components/comment-composer.tsx:289
msgid "Your text and attachments will be lost."
msgstr "អត្ថបទ និងឯកសារភ្ជាប់របស់អ្នកនឹងបាត់បង់។"

#: ../../../lib/web/src/components/comment-composer.tsx:292
msgid "Your text will be lost."
msgstr "អត្ថបទរបស់អ្នកនឹងបាត់បង់។"
